pkgbase = zcalld
	pkgdesc = Compact Linux AI gateway built on zcall with native zplugin extensions
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/@REPOSITORY@
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = python
	makedepends = cargo
	depends = glibc
	depends = libgcc
	depends = curl
	optdepends = systemd: system and user service management
	optdepends = zcalld-compat: privacy model, OAuth accounts and community plugins
	optdepends = zcall-gui: optional native desktop interface
	optdepends = libsecret: configure Zed credentials through Secret Service
	backup = etc/zcalld/config.conf
	source = zcalld-@VERSION@.tar.gz::https://github.com/@REPOSITORY@/releases/download/v@VERSION@/zcalld-@VERSION@-source.tar.gz
	sha256sums = @SOURCE_SHA256@

pkgname = zcalld
