[Unit]
Description=zcalld local AI gateway
Documentation=https://github.com/LIghtJUNction/zcalld
After=network.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/zcalld serve --config /etc/zcalld/config.conf
EnvironmentFile=-/etc/zcalld/credentials
DynamicUser=yes
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
