[Unit]
Description=zcalld local AI gateway
Documentation=https://github.com/LIghtJUNction/zcalld
After=network.target
ConditionPathExists=/var/lib/zcalld/config.conf

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/zcalld serve --config /var/lib/zcalld/config.conf
User=zcalld
Group=zcalld
StateDirectory=zcalld
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s
TimeoutStopSec=60s
KillMode=mixed
RuntimeDirectory=zcalld
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
