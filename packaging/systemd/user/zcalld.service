[Unit]
Description=zcalld local AI gateway
Documentation=https://github.com/LIghtJUNction/zcalld
After=network.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/zcalld serve --config %E/zcalld/config.conf
EnvironmentFile=-%E/zcalld/credentials
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
