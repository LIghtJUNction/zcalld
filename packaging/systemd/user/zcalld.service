[Unit]
Description=zcalld local AI gateway
Documentation=https://github.com/LIghtJUNction/zcalld
After=network.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/zcalld serve --config %E/zcalld/config.conf
Restart=on-failure
RestartSec=2s
TimeoutStopSec=60s
KillMode=mixed
RuntimeDirectory=zcalld
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
